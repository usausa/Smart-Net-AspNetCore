<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <RootNamespace>Smart.AspNetCore</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <PropertyGroup>
  </PropertyGroup>

  <Import Project="..\Smart.AspNetCore.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Usa.Smart.Text.Japanese" Version="3.0.0" />
    <PackageReference Include="SourceGenerateHelper" Version="2.0.0" />
    <PackageReference Include="SourceGenerateHelper.Testing" Version="2.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smart.AspNetCore.Generator\Smart.AspNetCore.Generator.csproj" OutputItemType="analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Smart.AspNetCore.Generator\Smart.AspNetCore.Generator.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Smart.AspNetCore\Smart.AspNetCore.csproj" />
    <ProjectReference Include="..\Smart.AspNetCore.Japanese\Smart.AspNetCore.Japanese.csproj" />
  </ItemGroup>

</Project>
